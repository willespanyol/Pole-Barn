{
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/pole-barn-permit-plans",
      "destination": "/blog/pole-barn-permit-plans/index.html"
    },
    {
      "source": "/blog/pole-barn-permit-plans/",
      "destination": "/blog/pole-barn-permit-plans/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
